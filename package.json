{
	"name": "tainacan",
	"private": true,
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "bun --bun next dev",
		"build": "bun --bun next build",
		"start": "bun --bun next start",
		"check": "bun run typecheck && bun run lint && bun run test && bun run build",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:api": "bun scripts/smoke-test-schemas.ts",
		"prepare": "lefthook install",
		"codegen:tainacan:fetch": "bun scripts/fetch-tainacan-openapi.ts",
		"codegen:tainacan": "bun scripts/codegen-tainacan.ts",
		"codegen:tainacan:sync": "bun run codegen:tainacan:fetch && bun run codegen:tainacan",
		"astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs",
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"biome:fix:unsafe": "biome check --write --unsafe .",
		"biome:format": "biome format --write .",
		"biome:lint": "biome lint ."
	},
	"dependencies": {
		"@astryxdesign/core": "^0.1.4",
		"@astryxdesign/theme-neutral": "^0.1.4",
		"@stylexjs/stylex": "0.18.3",
		"@tanstack/react-query": "^5.101.2",
		"axios": "^1.18.1",
		"next": "^16.2.10",
		"nuqs": "^2.9.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"use-debounce": "^10.1.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@astryxdesign/cli": "^0.1.4",
		"@biomejs/biome": "2.5.3",
		"@tanstack/react-query-devtools": "^5.101.2",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"lefthook": "^1.11.13",
		"orval": "^8.22.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
